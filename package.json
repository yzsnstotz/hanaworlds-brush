{
  "name": "hanaworlds-brush",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "MIT AND AGPL-3.0-only",
  "description": "Pure deterministic BUILD/V5 and region-build/v2 compiler; contracts v2.2.1, no world mutation",
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanaworlds-brush.git"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "types/",
    "licenses/",
    "build-provenance.json",
    "cordis.patch.yml",
    "GADGET.md",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "npm run verify:contracts && node tools/build.mjs && npm run test:package-boundary",
    "test": "npm run verify:contracts && node tools/build.mjs && node --test test/local-build.test.mjs test/region.test.mjs test/image-contracts.test.mjs test/shapes.test.mjs test/package.test.mjs && npm run test:package-boundary",
    "verify:contracts": "node tools/verify-contracts-artifact.mjs",
    "pack:artifact": "npm pack --pack-destination artifacts --json",
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 test/consumer.mts",
    "prepack": "npm run build",
    "test:package-boundary": "node tools/package-boundary.mjs"
  },
  "dependencies": {
    "canonicalize": "5.1.0"
  },
  "types": "./types/index.d.mts",
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "pnpm": "11.28.5",
    "typescript": "5.8.3",
    "hanaworlds-contracts": "git+https://github.com/yzsnstotz/hanaworlds-contracts.git#v2.2.1"
  }
}
